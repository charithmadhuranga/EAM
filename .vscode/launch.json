{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Rust Tests",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=${input:crate}"],
        "filter": {
          "name": "${input:crate}",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Tauri App",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./apps/desktop/src-tauri/Cargo.toml"
        ],
        "filter": {
          "name": "esphome-automation-manager",
          "kind": "bin"
        }
      },
      "preLaunchTask": "pnpm: dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/desktop/src",
      "preLaunchTask": "pnpm: dev-frontend"
    },
    {
      "name": "Debug Integration Tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--test", "${input:test}", "--no-run"],
        "filter": {
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "crate",
      "type": "pickString",
      "description": "Select crate to debug",
      "options": [
        "eam-domain",
        "eam-application",
        "eam-runtime",
        "eam-storage",
        "eam-device-manager",
        "eam-entity-registry",
        "eam-automation",
        "eam-history",
        "eam-dashboard",
        "eam-config",
        "eam-toolchain",
        "eam-discovery",
        "eam-security",
        "eam-observability",
        "eam-esphome-api"
      ],
      "default": "eam-domain"
    },
    {
      "id": "test",
      "type": "pickString",
      "description": "Select integration test",
      "options": [
        "device_integration",
        "automation_integration",
        "storage_integration"
      ],
      "default": "device_integration"
    }
  ]
}
